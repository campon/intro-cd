# logistic loss outputs probabilities in [0,1].
gbm_logit <- gbm(
formula = type ~ .,
data = trainSet,
distribution = "bernoulli", # logistic loss
n.trees = 300,
interaction.depth = 1,
shrinkage = 0.1,
cv.folds = 5,
verbose = FALSE
)
best_iter_logit <- gbm.perf(gbm_logit, method = "cv", plot.it = FALSE)
# predict test probabilities
prob_test_logit <- predict(gbm_logit, newdata = testSet,
n.trees = best_iter_logit, type = "response")
# convert to 0/1 using threshold 0.5
class_test_logit <- ifelse(prob_test_logit > 0.5, 1, 0)
test_err_logit <- mean(class_test_logit != testSet$type)
cat("Best iteration (bernoulli):", best_iter_logit, "\n")
cat("Test error (logit model)   :", test_err_logit, "\n")
cat("Test error (adaboost model):", finalTestError, "\n")
