knitr::opts_chunk$set(echo = TRUE)
library(kernlab)
data(spam)
# dimensions and structure of the dataset for the first 5 and "type" variables
dim(spam)
str(spam[,1:5])
str(spam$type)
# set seed for reproducibility
set.seed(123)
# select 70% of rows for training and remain for testing
train_index <- sample(1:nrow(spam), size = 0.7 * nrow(spam))
trainSet <- spam[train_index, ]
testSet  <- spam[-train_index, ]
# check the dimensions
dim(trainSet)
dim(testSet)
# examine the distribution of the response variable in train and test
table(trainSet$type)
table(testSet$type)
library(rpart)
default_tree <- rpart(type ~ ., data = trainSet, method = "class")
# plot the tree to see the splits structure
plot(default_tree)
text(default_tree, use.n=TRUE, all=TRUE, cex=0.8, xpd=TRUE)
stump_control <- rpart.control(maxdepth = 1)
stump_tree <- rpart(type ~ ., data = trainSet, method = "class",
control = stump_control)
# splits and nodes
stump_tree
# plot the stump
plot(stump_tree, uniform=TRUE, margin=0.1)
text(stump_tree, use.n=TRUE, all=TRUE, cex=0.8, xpd=TRUE)
head(default_tree$splits, 15)
head(stump_tree$splits)
# for reproducibility
set.seed(123)
# set cp=0 (complexity parameter) and minsplit=2 to grow a maximal tree
max_tree_control <- rpart.control(cp = 0, minsplit = 2)
max_tree <- rpart(type ~ ., data = trainSet, method = "class",
control = max_tree_control)
# we may not plot the maximal tree, as it may be too large
plot(max_tree, uniform=TRUE, margin=0.1)
text(max_tree, use.n=TRUE, all=TRUE, cex=0.6, xpd=TRUE)
# number of splits
max(max_tree$cptable[,"nsplit"])
# the cross-validation results are stored in max_tree$cptable
plotcp(max_tree)
max_tree$cptable[15:24,]
# the minimal cross-validation error is reached in size
which.min(max_tree$cptable[, "xerror"])
# and the minimal cross-validation error is:
min(max_tree$cptable[, "xerror"])
optimal_cp <- max_tree$cptable[which.min(max_tree$cptable[,"xerror"]),"CP"]
pruned_tree <- prune(max_tree, cp = optimal_cp)
# plot the pruned tree
plot(pruned_tree, uniform=TRUE, margin=0.1)
text(pruned_tree, use.n=TRUE, all=TRUE, cex=0.7)
# define a helper function to get misclassification error
misclass_error <- function(model, data) {
pred <- predict(model, data, type = "class")
mean(pred != data$type)
}
# training set
err_default_train <- misclass_error(default_tree, trainSet)
err_stump_train   <- misclass_error(stump_tree,   trainSet)
err_max_train     <- misclass_error(max_tree,     trainSet)
err_pruned_train  <- misclass_error(pruned_tree,  trainSet)
# test set
err_default_test <- misclass_error(default_tree, testSet)
err_stump_test   <- misclass_error(stump_tree,   testSet)
err_max_test     <- misclass_error(max_tree,     testSet)
err_pruned_test  <- misclass_error(pruned_tree,  testSet)
# summarizing
error_comp <- data.frame(
Tree = c("Default", "Stump", "Maximal", "Pruned"),
Train_Error = c(err_default_train, err_stump_train,
err_max_train, err_pruned_train),
Test_Error  = c(err_default_test, err_stump_test,
err_max_test, err_pruned_test)
)
error_comp
library(randomForest)
# define the number of variables
p <- ncol(trainSet) - 1
rf_bagging <- randomForest(type ~ ., data = trainSet,
mtry = p, importance = TRUE)
# calculate the error on the training set and test set
bagging_err_train <- mean(predict(rf_bagging, trainSet) != trainSet$type)
bagging_err_test  <- mean(predict(rf_bagging, testSet)  != testSet$type)
gain_test <- err_default_test - bagging_err_test
gain_train <- err_default_train - bagging_err_train
errors <- data.frame(
Tree = c("Unpruned bagging", "Default", "Gain/Loss"),
Train_Error = c(bagging_err_train, err_default_train, gain_train),
Test_Error  = c(bagging_err_test, err_default_test, gain_test)
)
errors
rf_default <- randomForest(type ~ ., data = trainSet,
importance = TRUE)
rf_default_err_train <- mean(predict(rf_default, trainSet) != trainSet$type)
rf_default_err_test  <- mean(predict(rf_default, testSet)  != testSet$type)
print(paste("Unpruned bagging error in training set:", round(bagging_err_train, 4)))
print(paste("Unpruned bagging error in test set:", round(bagging_err_test, 4)))
cat("\n")
print(paste("RF default tree error in training set:", round(rf_default_err_train, 4)))
print(paste("RF default tree error in test set:", round(rf_default_err_test, 4)))
cat("\n")
print(paste("Gain or loss between RF default tree and unpruned bagging in training set:",
round(rf_default_err_train - bagging_err_train, 4)))
print(paste("Gain or loss between RF default tree and unpruned bagging in test set:",
round(rf_default_err_test - bagging_err_test, 4)))
rf_trace <- randomForest(type ~ ., data = trainSet,
mtry = floor(sqrt(p)),
importance = TRUE,
do.trace = 50)   # print progress every 50 trees
plot(rf_trace)
varImp_default <- importance(rf_default)
head(varImp_default[order(varImp_default[,"MeanDecreaseAccuracy"], decreasing = TRUE),],10)
varImpPlot(rf_default)
stumps_control <- randomForest(type ~ ., data = trainSet,
mtry = floor(sqrt(p)),
maxnodes = 2,   # stump
importance = TRUE)
varImp_stumps <- importance(stumps_control)
# compare
head(varImp_stumps[order(varImp_stumps[,"MeanDecreaseAccuracy"], decreasing=TRUE), ], 10)
mtry_values <- c(1, 5, floor(sqrt(p)), 15, 20, 30, 40, p)
oob_errors <- numeric(length(mtry_values))
for(i in seq_along(mtry_values)){
print(paste("mtry =", mtry_values[i]))
rf_temp <- randomForest(type ~ ., data = trainSet,
mtry = mtry_values[i],
importance = FALSE,
ntree = 200,
do.trace = FALSE)
oob_errors[i] <- rf_temp$err.rate[rf_temp$ntree, "OOB"]
}
data.frame(mtry = mtry_values, OOB_Error = oob_errors)
# plot
plot(data.frame(mtry = mtry_values, OOB_Error = oob_errors), type = "b", xlab = "mtry", ylab = "OOB Error")
library(gbm)
# change response variable to 1's and 0's
trainSet$type <- ifelse(trainSet$type == "spam", 1, 0)
testSet$type <- ifelse(testSet$type == "spam", 1, 0)
gbm_adaboost <- gbm(
formula = type ~ .,
data = trainSet,
distribution = "adaboost",
n.trees = 300,
interaction.depth = 1, # tree depth set to stumps
shrinkage = 0.1,       # learning rate
cv.folds = 5,
n.minobsinnode = 10,   # minimum number of observations in trees terminal nodes
verbose = FALSE
)
# find an optimal number of iterations
best_iter_adaboost <- gbm.perf(gbm_adaboost, method = "cv")
best_iter_adaboost
for(i in seq_len(300)){
# preditions on training set
pred_train <- predict(gbm_adaboost, newdata = trainSet,
n.trees = i, type = "response")
# for adaboost, predictions can be on a numeric scale
# we classify by sign greater 0 as spam
class_train <- ifelse(pred_train >= 0.5, 1, 0)
trainError[i] <- mean(class_train != trainSet$type)
# predict on test set
pred_test <- predict(gbm_adaboost, newdata = testSet,
n.trees = i, type = "response")
class_test <- ifelse(pred_test >= 0.5, 1, 0)
testError[i] <- mean(class_test != testSet$type)
}
# now we plot the training and test error rates over iterations
plot(1:300, trainError, type = "l", col = "blue",
ylim = c(0, max(testError)),
xlab = "Number of Trees", ylab = "Error Rate",
main = "Training and Test Error vs. Number of Trees (AdaBoost)")
lines(1:300, testError, type = "l", col = "red")
legend("topright", legend = c("Training Error", "Test Error"),
col = c("blue", "red"), lty = 1)
pred_train_final <- predict(gbm_adaboost, newdata = trainSet,
n.trees = best_iter_adaboost, type = "response")
class_train_final <- ifelse(pred_train_final >= 0.5, 1, 0)
finalTrainError <- mean(class_train_final != trainSet$type)
pred_test_final <- predict(gbm_adaboost, newdata = testSet,
n.trees = best_iter_adaboost, type = "response")
class_test_final <- ifelse(pred_test_final >= 0.5, 1, 0)
finalTestError <- mean(class_test_final != testSet$type)
cat("Final AdaBoost Training Error:", finalTrainError, "\n")
cat("Final AdaBoost Test Error    :", finalTestError, "\n")
### 5.5 Which variables have the greatest influence on the selected model?
summary(gbm_adaboost, n.trees = best_iter_adaboost)
# The top variables in the summary are those that contribute most to reducing the AdaBoost loss.
# compare
head(varImp_stumps[order(varImp_stumps[,"MeanDecreaseAccuracy"], decreasing=TRUE), ], 10)
param_grid <- expand.grid(
n.trees = c(100, 200),
depth   = c(1, 2),
shrink  = c(0.1, 0.01)
)
results_param <- data.frame()
for(r in seq_len(nrow(param_grid))){
set.seed(100 + r)
fit <- gbm(
formula = type ~ .,
data = trainDF,
distribution = "adaboost",
n.trees = param_grid$n.trees[r],
interaction.depth = param_grid$depth[r],
shrinkage = param_grid$shrink[r],
cv.folds = 5,
verbose = FALSE
)
best_iter <- gbm.perf(fit, method = "cv", plot.it = FALSE)
# predict on the test set at the best iteration
pred_test_cur <- predict(fit, newdata = testDF, n.trees = best_iter, type = "response")
class_test_cur <- ifelse(pred_test_cur >= 0, 1, 0)
test_err_cur <- mean(class_test_cur != testDF$type)
results_param <- rbind(
results_param,
data.frame(
n.trees = param_grid$n.trees[r],
depth   = param_grid$depth[r],
shrink  = param_grid$shrink[r],
best_iter_cv = best_iter,
test_error   = test_err_cur
)
)
}
